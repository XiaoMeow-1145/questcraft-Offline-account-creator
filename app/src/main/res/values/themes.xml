<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material主题（默认） -->
    <style name="Theme.QcofA" parent="Theme.QcofA.Material" />

    <style name="Theme.QcofA.Material" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- 辅助色调 -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- 表面颜色 -->
        <item name="android:statusBarColor">@color/surface_container_highest</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        
        <!-- 背景颜色 - 使用android命名空间 -->
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorForeground">@color/on_surface</item>
        
        <!-- 错误颜色 -->
        <item name="colorError">@color/state_error</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Material Design组件样式 -->
        <item name="materialButtonStyle">@style/Widget.QcofA.Button</item>
        <item name="textInputStyle">@style/Widget.QcofA.TextInputLayout</item>
    </style>

    <!-- 【新增 v1.4】Miuix主题 - 橙色系 -->
    <style name="Theme.QcofA.Miuix" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 - Miuix风格的橙色系 -->
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorPrimaryVariant">@color/miuix_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- 辅助色调 -->
        <item name="colorSecondary">@color/miuix_secondary</item>
        <item name="colorSecondaryVariant">@color/miuix_secondary_container</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- 表面颜色 -->
        <item name="android:statusBarColor">@color/miuix_surface_container_highest</item>
        <item name="android:windowBackground">@color/miuix_surface</item>
        <item name="colorSurface">@color/miuix_surface</item>
        <item name="colorOnSurface">@color/miuix_on_surface</item>
        
        <!-- 背景颜色 -->
        <item name="android:colorBackground">@color/miuix_surface</item>
        <item name="android:colorForeground">@color/miuix_on_surface</item>
        
        <!-- 错误颜色 -->
        <item name="colorError">@color/state_error</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Miuix组件样式 -->
        <item name="materialButtonStyle">@style/Widget.QcofA.MiuixButton</item>
        <item name="textInputStyle">@style/Widget.QcofA.MiuixTextInputLayout</item>
    </style>

    <!-- 按钮样式 -->
    <style name="Widget.QcofA.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 文本输入框样式 -->
    <style name="Widget.QcofA.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeColor">@color/outline_variant</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
    </style>

    <!-- 复选框样式 -->
    <style name="Widget.QcofA.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/primary</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- 【新增 v1.4】Miuix按钮样式 - 胶囊风格 -->
    <style name="Widget.QcofA.MiuixButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/miuix_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 【新增 v1.4】Miuix文本输入框样式 -->
    <style name="Widget.QcofA.MiuixTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxStrokeColor">@color/miuix_outline_variant</item>
        <item name="hintTextColor">@color/miuix_on_surface_variant</item>
    </style>

    <!-- 颜色定义 - 基于参考UI的设计系统 -->
    <!-- 主色调 -->
    <color name="primary">#4758A9</color>
    <color name="primary_light">#6774B8</color>
    <color name="primary_dark">#344293</color>
    <color name="primary_container">#DCE1F9</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_container">#111B4B</color>

    <!-- 辅助色调 -->
    <color name="secondary">#585E71</color>
    <color name="secondary_container">#DCE2F9</color>
    <color name="on_secondary">#FFFFFF</color>

    <!-- 第三色调 -->
    <color name="tertiary">#735572</color>
    <color name="tertiary_container">#FFD8F4</color>

    <!-- 表面颜色 -->
    <color name="surface">#FFFBFE</color>
    <color name="surface_dim">#DED8E1</color>
    <color name="surface_bright">#FFFBFE</color>
    <color name="surface_container_lowest">#FFFFFF</color>
    <color name="surface_container_low">#F7F2FA</color>
    <color name="surface_container">#F2ECF4</color>
    <color name="surface_container_high">#ECE6F0</color>
    <color name="surface_container_highest">#E6E0EB</color>
    <color name="on_surface">#1C1B1F</color>
    <color name="on_surface_variant">#47464F</color>
    <color name="surface_variant">#E3E1EC</color>

    <!-- 轮廓颜色 -->
    <color name="outline">#79747E</color>
    <color name="outline_variant">#CAC4D0</color>

    <!-- 状态颜色 -->
    <color name="state_success">#386A20</color>
    <color name="state_success_container">#B8F397</color>
    <color name="state_warning">#7C5800</color>
    <color name="state_warning_container">#FFDEA6</color>
    <color name="state_error">#BA1A1A</color>
    <color name="state_error_container">#FFDAD6</color>
    <color name="state_info">#4758A9</color>
    <color name="state_info_container">#DCE1F9</color>

    <!-- 基础颜色 -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- 【新增 v1.4】Miuix颜色定义 - 橙色系 -->
    <color name="miuix_primary">#FF6B35</color>
    <color name="miuix_primary_dark">#E55A2B</color>
    <color name="miuix_primary_container">#FFF0E8</color>
    <color name="miuix_secondary">#FF8F5E</color>
    <color name="miuix_secondary_container">#FFF0E8</color>
    <color name="miuix_surface">#FFF8F5</color>
    <color name="miuix_surface_container_highest">#F5EDE8</color>
    <color name="miuix_on_surface">#1C1B1F</color>
    <color name="miuix_on_surface_variant">#5C5248</color>
    <color name="miuix_outline_variant">#D9C8BC</color>
</resources>