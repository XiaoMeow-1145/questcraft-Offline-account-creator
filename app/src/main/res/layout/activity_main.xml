<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">



        <!-- 第一个卡片：离线账户配置 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 卡片标题 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="配置离线账户文件"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <!-- 用户名输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.QcofA.TextInputLayout"
                    app:boxBackgroundColor="@color/surface_container_low">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="用户名"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 可折叠区域标题 -->
                <LinearLayout
                    android:id="@+id/expandableSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:layout_marginBottom="8dp">

                    <!-- 三角符号指示器 -->
                    <TextView
                        android:id="@+id/expandIndicator"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="▶"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:gravity="center"
                        android:layout_marginEnd="8dp" />

                    <!-- 其他功能文本 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="其他功能"
                        android:textSize="16sp"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 可折叠区域 -->
                <LinearLayout
                    android:id="@+id/expandableSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 自定义UUID输入 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.QcofA.TextInputLayout"
                        app:boxBackgroundColor="@color/surface_container_low">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customUuidInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="自定义UUID (留空则自动生成)"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 用户类型选择 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="用户类型"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/userTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                    <!-- UUID显示 -->
                    <TextView
                        android:id="@+id/uuidDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="UUID: "
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:background="@color/surface_container"
                        android:padding="12dp"
                        android:typeface="monospace" />
                </LinearLayout>

                <!-- 操作按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createAccountBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="创建账号文件"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewAccountsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="查看已创建账号列表"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 第二个卡片：用户简单配置 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 卡片标题 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="用户简单配置"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <!-- 配置选项 -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/legalCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已接受法律条款 (acceptedLegal)"
                    android:checked="true"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/devModsCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启用开发者模组 (setDevMods)"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/customRamCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义内存 (setCustomRAM)"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="12dp" />

                <!-- 内存值输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.QcofA.TextInputLayout"
                    app:boxBackgroundColor="@color/surface_container_low">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ramValueInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="自定义内存值 (如: 2048)"
                        android:inputType="number"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/demoModeCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="演示模式 (isDemoMode)"
                    style="@style/Widget.QcofA.CheckBox"
                    android:layout_marginBottom="20dp" />

                <!-- 操作按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveConfigBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="保存配置文件"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manualInstallJreBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="手动安装JRE Runtime"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>