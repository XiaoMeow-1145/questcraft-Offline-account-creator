<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">



    <!-- 第一个模块：离线账户配置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="配置离线账户文件"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        
        <EditText
            android:id="@+id/usernameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="用户名" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UUID自动生成" />

        <Button
            android:id="@+id/generateUuidBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="生成UUID" />

    </LinearLayout>

    <TextView
        android:id="@+id/uuidDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="UUID: "
        android:textIsSelectable="true" />

    <Button
        android:id="@+id/createAccountBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="创建账号文件"
        android:layout_marginBottom="30dp" />

    <!-- 第二个模块：简单配置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="用户简单配置"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <CheckBox
        android:id="@+id/legalCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="已接受法律条款 (acceptedLegal)"
        android:checked="true"
        android:layout_marginBottom="5dp" />

    <CheckBox
        android:id="@+id/devModsCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启用开发者模组 (setDevMods)"
        android:layout_marginBottom="5dp" />

    <CheckBox
        android:id="@+id/customRamCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自定义内存 (setCustomRAM)"
        android:layout_marginBottom="5dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        
        <EditText
            android:id="@+id/ramValueInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="自定义内存值 (如: 2048)"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/demoModeCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="演示模式 (isDemoMode)"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/saveConfigBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存配置文件"
        android:layout_marginBottom="20dp" />

    <!-- 导入功能 -->
    <Button
        android:id="@+id/importAccountBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="导入账号"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp" />

</LinearLayout>